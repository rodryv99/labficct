# Copia este archivo como .env (en esta misma carpeta) y ajusta los valores.
# El contenedor de PostgreSQL también lee este archivo.

# ── Django ──────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
# Agrega aquí la IP de tu PC en la red si pruebas la app en un celular físico.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,backend
TIME_ZONE=America/La_Paz

# ── Rutas (las usa config/urls.py) ──────────────────────
API_PREFIX=api/v1/
WS_PREFIX=ws/
ADMIN_URL=panel-django/

# ── Base de datos ───────────────────────────────────────
POSTGRES_DB=labficct
POSTGRES_USER=labficct
POSTGRES_PASSWORD=labficct-dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis y Celery ──────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
# Minutos antes de cada clase o reserva en que se avisa a los auxiliares que alisten el aula.
AVISO_ALISTAR_MINUTOS=15

# ── Clientes permitidos ─────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── JWT ─────────────────────────────────────────────────
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_REFRESH_COOKIE_NAME=labficct_refresh

# ── Cifrado de credenciales de laboratorio ──────────────
# Clave SOLO para desarrollo. En producción genera una nueva con:
#   docker compose run --rm backend python manage.py generar_claves
FIELD_ENCRYPTION_KEY=4x-S_pleeu7MfMTqFvXZK1eMb0bgumQQmGWNfwW8yQo=

# ── Archivos ────────────────────────────────────────────
MEDIA_URL=/media/
MEDIA_ROOT=/app/media
# Fotos del CI de quien recoge un objeto perdido: sin URL pública.
PRIVADO_ROOT=/app/privado

# ── Horario de atención ─────────────────────────────────
# Las clases y reservas deben caber en este rango.
ATENCION_INICIO=07:00
ATENCION_FIN=22:45
# Botones de "franjas habituales" al registrar un horario (inicio-fin, separadas por coma).
FRANJAS_HABITUALES=07:00-09:15,09:15-11:30,11:30-13:45,13:45-16:00,16:00-18:15,18:15-20:30,20:30-22:45,07:00-08:30,08:30-10:00,10:00-11:30,11:30-13:00,14:00-15:30,15:30-17:00,18:15-19:45,19:45-21:15
