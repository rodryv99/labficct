# Copia este archivo como dev.env y ejecuta:
#   flutter run --dart-define-from-file=env/dev.env
#
# 10.0.2.2 es tu PC vista desde el emulador de Android.
# Con un celular físico usa la IP de tu PC en la red (ej. 192.168.1.50)
# y agrégala a DJANGO_ALLOWED_HOSTS en backend/.env.
APP_NAME="Laboratorios FICCT"
API_BASE_URL=http://10.0.2.2:8000/api/v1
WS_BASE_URL=ws://10.0.2.2:8000/ws
